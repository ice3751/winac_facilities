# نمونه تنظیمات Production. این فایل را به .env کپی و مقادیر را تکمیل کنید.
# نکته امنیتی: SECRET_KEY باید یک مقدار تصادفی و محرمانه باشد.

SECRET_KEY=PUT-A-LONG-RANDOM-SECRET-HERE
DEBUG=False

# دامنه/آی‌پی سرور داخلی سازمان
ALLOWED_HOSTS=winac.intranet.local,10.0.0.10
CSRF_TRUSTED_ORIGINS=https://winac.intranet.local

# دیتابیس نهایی (postgres یا mssql توصیه می‌شود)
DB_ENGINE=postgres
DB_NAME=winac
DB_USER=winac_app
DB_PASSWORD=STRONG-DB-PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa

# کلید API دستگاه تردد
DEVICE_API_KEY=PUT-A-RANDOM-DEVICE-KEY

# ایمیل سازمانی (SMTP)
NOTIFY_EMAIL_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.intranet.local
EMAIL_PORT=587
EMAIL_HOST_USER=winac
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=winac-noreply@yourorg.ir
