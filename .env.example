# نمونه تنظیمات محیطی. این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
# cp .env.example .env

# کلید امنیتی جنگو (در Production حتماً مقدار تصادفی و محرمانه قرار دهید)
SECRET_KEY=change-me-in-production

# حالت دیباگ: در توسعه True و در Production False
DEBUG=True

# میزبان‌های مجاز، با کاما جدا شوند
ALLOWED_HOSTS=127.0.0.1,localhost

# نوع دیتابیس: sqlite | postgres | mssql
DB_ENGINE=sqlite

# تنظیمات دیتابیس (برای postgres یا mssql لازم است)
DB_NAME=winac
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# منطقه زمانی و زبان
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa
