# نمونه تنظیمات Production — ویندوز سرور + SQL Server + دامنهٔ داخلی (HTTP)
# این فایل را روی سرور به .env کپی و مقادیر را تکمیل کنید.

# کلید امنیتی (حتماً یک مقدار تصادفی و محرمانه بگذارید)
SECRET_KEY=PUT-A-LONG-RANDOM-SECRET-HERE
DEBUG=False

# دامنهٔ داخلی و آدرس سرور (با کاما جدا)
ALLOWED_HOSTS=winac.intranet.local,DEV,10.0.0.10
# برای فرم‌ها روی HTTP داخلی معمولاً لازم نیست؛ اگر HTTPS شد مقداردهی کنید:
# CSRF_TRUSTED_ORIGINS=http://winac.intranet.local

# --- دیتابیس: SQL Server ---
DB_ENGINE=mssql
DB_NAME=winac
DB_HOST=DEV\SQLEXPRESS        # یا نام/آی‌پی اینستنس SQL Server
DB_PORT=1433
# احراز هویت SQL: یوزر/رمز را پر کنید
DB_USER=winac_app
DB_PASSWORD=STRONG-DB-PASSWORD
# اگر می‌خواهید با احراز هویت ویندوزی وصل شوید، DB_USER و DB_PASSWORD را خالی بگذارید.
DB_DRIVER=ODBC Driver 17 for SQL Server
# اگر از ODBC Driver 18 استفاده می‌کنید این را هم اضافه کنید:
# DB_EXTRA_PARAMS=TrustServerCertificate=yes

TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa

# --- ایمیل سازمانی (SMTP) ---
NOTIFY_EMAIL_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email.winac-co.com
EMAIL_PORT=25
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tashrifat@winac-co.com
EMAIL_HOST_PASSWORD=CHANGE-ME
DEFAULT_FROM_EMAIL=ویناک <tashrifat@winac-co.com>

# کلید API دستگاه تردد (فاز اتصال دستگاه)
DEVICE_API_KEY=PUT-A-RANDOM-DEVICE-KEY

# --- اجرای سرور (waitress) ---
SERVE_HOST=0.0.0.0
SERVE_PORT=80
SERVE_THREADS=8
