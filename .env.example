# نمونه تنظیمات محیطی. این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
# cp .env.example .env

# کلید امنیتی جنگو (در Production حتماً مقدار تصادفی و محرمانه قرار دهید)
SECRET_KEY=change-me-in-production

# حالت دیباگ: در توسعه True و در Production False
DEBUG=True

# میزبان‌های مجاز، با کاما جدا شوند
ALLOWED_HOSTS=127.0.0.1,localhost

# نوع دیتابیس: sqlite | postgres | mssql
DB_ENGINE=sqlite

# تنظیمات دیتابیس (برای postgres یا mssql لازم است)
DB_NAME=winac
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# منطقه زمانی و زبان
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa

# کلید احراز هویت API داخلی دستگاه تردد (فاز اتصال دستگاه)
# دستگاه باید این مقدار را در هدر X-API-KEY ارسال کند
DEVICE_API_KEY=change-me-device-key

# ایمیل (اطلاع‌رسانی به مدیر اداری و میزبان‌ها)
# در توسعه console کافی است؛ برای ارسال واقعی، SMTP سازمان را تنظیم کنید.
NOTIFY_EMAIL_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=winac-noreply@example.org
